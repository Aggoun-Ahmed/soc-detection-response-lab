<group name="soc_sysmon_lab,">
  <!-- Safe proof-of-pipeline test: Notepad is not suspicious by itself. -->
  <rule id="100130" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\notepad\.exe$</field>
    <description>SOC LAB: Notepad process creation detected via Sysmon</description>
    <group>soc_lab,sysmon_test,</group>
  </rule>
</group>
